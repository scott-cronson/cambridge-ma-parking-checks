# Copy to .env on the server (/opt/cambridge-ma-parking-checks/.env, mode 600, owner parkingbot).
# install.sh creates it from this file on first run. Personal values live only here, never in git.
# Lists are comma separated.

# --- Car ---------------------------------------------------------------------------------------
# Required.
PLATE=
PLATE_STATE=MA

# --- Alerts: email -----------------------------------------------------------------------------
ALERT_EMAILS=you@example.com
# Preferred where outbound SMTP is blocked (common on cloud VMs): a Google Apps Script relay.
# Deploy deploy/apps_script_email.gs as a web app; install.sh generates EMAIL_WEBHOOK_SECRET.
# When EMAIL_WEBHOOK_URL is set, the SMTP settings below are ignored.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
# Alternative: Gmail SMTP with an app password (needs outbound port 587).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
# 16-character app password from https://myaccount.google.com/apppasswords (needs 2-Step Verification)
SMTP_PASSWORD=
SMTP_FROM=you@example.com

# --- Alerts: Telegram (second channel) ---------------------------------------------------------
# Create a bot with @BotFather, send it any message, then run `parking-checks telegram-chat-id`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# --- Intake endpoint (iOS Shortcut posts here) ------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTAKE_TOKEN=
INTAKE_HOST=127.0.0.1
INTAKE_PORT=8787
# Public URL the Shortcut uses, for README/notify-test output only.
PUBLIC_BASE_URL=https://<node>.<tailnet>.ts.net:8443

# --- Coverage ----------------------------------------------------------------------------------
# The point data/street_cleaning.json was built around (its radius_m), e.g. your home. Parking on a
# street the file lacks is "street not in file" within 600 m of it, "outside coverage" beyond.
COVERAGE_CENTER_LAT=
COVERAGE_CENTER_LON=

# --- Checks ------------------------------------------------------------------------------------
FRESHNESS_MAX_AGE_HOURS=24
# systemd OnCalendar for the freshness check; install.sh writes it into the timer.
FRESHNESS_ON_CALENDAR=Wed *-*-* 07:00:00 America/New_York
TOW_REMINDER_HOURS=12
TOW_REMINDER_MAX=4
CLEANING_LOOKAHEAD_DAYS=2
# Days the 3-hourly tow-sweep keeps sampling the lookup for the latency log (0 disables it).
LATENCY_SAMPLE_DAYS=14

# --- Paths and HTTP ----------------------------------------------------------------------------
DB_PATH=/var/lib/parking-checks/state.db
# SCHEDULE_PATH defaults to data/street_cleaning.json in the repo.
HTTP_USER_AGENT=cambridge-ma-parking-checks/0.1 (personal tow and street-cleaning alerts; contact: you@example.com)
