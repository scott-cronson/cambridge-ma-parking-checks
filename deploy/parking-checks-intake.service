# Intake endpoint for the iOS Shortcut. Listens on 127.0.0.1:8787; Tailscale Funnel
# publishes it at https://<node>.<tailnet>.ts.net:8443.
[Unit]
Description=parking-checks intake endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=parkingbot
Group=parkingbot
WorkingDirectory=/opt/cambridge-ma-parking-checks
Environment=PARKING_CHECKS_ENV=/opt/cambridge-ma-parking-checks/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/cambridge-ma-parking-checks/.venv/bin/parking-checks serve-intake
Restart=always
RestartSec=5
StateDirectory=parking-checks
StateDirectoryMode=0700
MemoryMax=150M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
